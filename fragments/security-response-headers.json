{
  "id": "security-response-headers",
  "name": "security-response-headers",
  "kind": "fragment",
  "description": "Response headers required by the security baseline (audit control SEC-14).",
  "tags": [
    "platform",
    "security"
  ],
  "data": {
    "enabled": true,
    "add": [
      {
        "name": "Strict-Transport-Security",
        "value": "max-age=63072000; includeSubDomains"
      },
      {
        "name": "X-Content-Type-Options",
        "value": "nosniff"
      },
      {
        "name": "Cache-Control",
        "value": "no-store"
      }
    ]
  }
}
